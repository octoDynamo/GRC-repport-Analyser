# ─── Database ────────────────────────────────────────────────────────────────
# Docker setup (default): PostgreSQL runs on port 5434 via docker-compose
DATABASE_URL=postgresql+asyncpg://grc_user:grc_secret@localhost:5434/grc_db

# Windows-native PostgreSQL (if you have a local install on port 5433):
# DATABASE_URL=postgresql+asyncpg://grc_user:YOUR_PG_PASSWORD@localhost:5433/grc_db

# ─── Mistral AI ──────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grc-reports
MINIO_SECURE=false

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=GRC AI Analyzer
APP_VERSION=1.0.0
DEBUG=true
