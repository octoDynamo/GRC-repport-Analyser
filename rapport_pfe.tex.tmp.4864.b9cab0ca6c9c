  \draw[-{Latex[length=2mm]},dashed] (chroma) -- (search);
\end{tikzpicture}
\caption{Pipeline RAG~: indexation et requ\^etage s\'emantique}
\label{fig:rag}
\end{figure}

\subsection{Indexation vectorielle}

\begin{lstlisting}[caption={Indexation des chunks dans ChromaDB (vector\_store.py)}, label={lst:index}]
async def index_document_chunks(analyse_id: str, chunks: list[str]) -> int:
    client = get_chroma_client()
    model  = get_embedding_model()   # singleton MiniLM, charge une seule fois

    collection = await asyncio.to_thread(
        client.get_or_create_collection,
        name=f"analyse_{analyse_id.replace('-', '_')}",
        metadata={"hnsw:space": "cosine"},
    )
    # Encodage CPU-intensif deplace dans un thread (non bloquant)
    embeddings = await asyncio.to_thread(
        model.encode, chunks, show_progress_bar=False
    )
    await asyncio.to_thread(
        collection.add,
        documents=chunks,
        embeddings=embeddings.tolist(),
        ids=[str(uuid.uuid4()) for _ in chunks],
        metadatas=[{"chunk_index": i} for i in range(len(chunks))],
    )
    return len(chunks)
\end{lstlisting}

\subsection{G\'en\'eration augment\'ee (chat)}

\begin{lstlisting}[caption={Chat RAG --- r\'ecup\'eration et g\'en\'eration (chat\_engine.py)}, label={lst:chat}]
async def answer_question(analyse_id: str, question: str, top_k: int = 5) -> dict:
    # Etape 1 : recuperer les k extraits semantiquement proches
    results = await search_similar_chunks(analyse_id, question, top_k=top_k)
    if not results:
        return {"reponse": "Aucune information pertinente trouvee.", "sources": []}

    # Etape 2 : construire le contexte a partir des extraits
    context = "\n\n".join(
        f"[Extrait {i+1}]: {r['text']}" for i, r in enumerate(results)
    )
    # Etape 3 : generer la reponse en se basant uniquement sur le contexte
    user_prompt = CHAT_USER_PROMPT.format(context_chunks=context, question=question)
    reponse = await call_mistral(CHAT_SYSTEM_PROMPT, user_prompt, temperature=0.3)
    return {"reponse": reponse, "sources": [r["text"][:300] for r in results]}
\end{lstlisting}

