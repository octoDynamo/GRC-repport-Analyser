  \draw[-{Latex[length=2mm]}] (validate) -- (db);
\end{tikzpicture}
\caption{Pipeline d'ingestion documentaire}
\label{fig:upload-pipeline}
\end{figure}

\subsection{Strat\'egies d'extraction par format}

\begin{table}[ht]
\centering
\renewcommand{\arraystretch}{1.3}
\begin{tabular}{|l|l|p{7cm}|}
\hline
\rowcolor{lightgray}
\textbf{Format} & \textbf{Biblioth\`eque} & \textbf{Strat\'egie d'extraction} \\
\hline
PDF & PyMuPDF (\texttt{fitz}) & It\'eration page par page, marquage \texttt{=== Page N ===}, pr\'eservation de l'ordre de lecture \\
\hline
DOCX & python-docx & It\'eration sur paragraphes (d\'etection des styles Heading) et sur les cellules de tableaux \\
\hline
XLSX & openpyxl & Lecture de toutes les feuilles, concat\'enation des valeurs de cellules par ligne \\
\hline
\end{tabular}
\caption{Strat\'egies d'extraction par format documentaire}
\label{tab:parsers}
\end{table}

\subsection{Chunking pour le RAG}

Le texte extrait est d\'ecoup\'e en fragments de 1\,500 caract\`eres avec un chevauchement de 200 caract\`eres, garantissant la continuit\'e s\'emantique entre chunks adjacents.

\begin{lstlisting}[caption={Fonction de d\'ecoupage (\texttt{document\_parser.py})},label=lst:chunk]
def chunk_text(
    text: str,
    chunk_size: int = 1500,
    overlap: int = 200
) -> list[str]:
    if len(text) <= chunk_size:
        return [text]
    chunks, start = [], 0
    while start < len(text):
        end = start + chunk_size
        chunks.append(text[start:end])
        if end >= len(text):
            break
        start = end - overlap
    return chunks
\end{lstlisting}

