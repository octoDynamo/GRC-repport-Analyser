\subsection{Matrice des risques}
% ----------------------------------------------------------

\begin{figure}[htbp]
\centering
\fbox{\parbox{0.92\textwidth}{\centering\vspace{3.4cm}
  \textcolor{darknavy!60}{\large\textit{[ Capture : Matrice des risques ]}}\\[0.5cm]
  \small\texttt{figures/screenshots/risk\_matrix.png}
