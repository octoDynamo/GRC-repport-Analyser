% ----------------------------------------------------------
\subsection{Tableau de bord --- liste des rapports}
% ----------------------------------------------------------

\begin{figure}[htbp]
\centering
\fbox{\parbox{0.92\textwidth}{\centering\vspace{3.0cm}
  \textcolor{darknavy!60}{\large\textit{[ Capture : Tableau de bord ]}}\\[0.5cm]
  \small\texttt{figures/screenshots/dashboard.png}
